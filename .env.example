# Runtime
APP_ENV=local
LOG_LEVEL=INFO
API_PORT=8000
API_PUBLIC_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# PostgreSQL / Supabase local defaults
DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:54322/postgres
SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=
# Preferred browser-safe key name for current Supabase projects.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback for projects still exposing an anon key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# S3-compatible media storage (MinIO locally, Cloudflare R2 in production)
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=auto
S3_BUCKET=adnelyq-media
R2_ACCESS_KEY=minioadmin
R2_SECRET_KEY=minioadmin
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Email (Mailpit locally, Resend in production)
SMTP_HOST=mailpit
SMTP_PORT=1025
EMAIL_FROM=Adnelyq <hello@local.adnelyq.test>
RESEND_API_KEY=

# Advertising integrations
META_CLIENT_ID=
META_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=

# AI
OPENAI_API_KEY=

# Observability and product analytics
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
